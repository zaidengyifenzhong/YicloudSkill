include LICENSE THIRD_PARTY.md
recursive-include licenses *.txt
recursive-include src/yicloud/data *.json
recursive-include src/yicloud/skill *.md *.yaml
include install.sh install.ps1
recursive-include tools *.py *.go *.json
recursive-include tests *.py *.json
exclude CONTRIBUTING.md CHANGELOG* CHANGES* HISTORY*
prune docs
prune reports
prune audits
prune issues
prune logs
global-exclude *.log .DS_Store
